<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.0.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.2.2" />
    <!-- Service Discovery -->
    <PackageVersion Include="NConsul" Version="0.8.1" />
    <PackageVersion Include="nacos-sdk-csharp" Version="1.3.10" />
    <PackageVersion Include="nacos-sdk-csharp.AspNetCore" Version="1.3.10" />
    <PackageVersion Include="nacos-sdk-csharp.Extensions.Configuration" Version="1.3.10" />
    <PackageVersion Include="nacos-sdk-csharp.IniParser" Version="1.3.10" />
    <PackageVersion Include="nacos-sdk-csharp.YamlParser" Version="1.3.10" />
    <!-- API Gateway -->
    <PackageVersion Include="Ocelot" Version="25.0.2" />
    <PackageVersion Include="Ocelot.Cache.CacheManager" Version="25.0.2" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Database -->
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
    <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
    <!-- Cache & Messaging -->
    <PackageVersion Include="Confluent.Kafka" Version="2.6.1" />
    <PackageVersion Include="FreeRedis" Version="1.5.5" />
    <PackageVersion Include="RabbitMQ.Client" Version="6.8.1" />
    <!-- Observability -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <!-- AutoMapper -->
    <PackageVersion Include="AutoMapper" Version="16.2.0" />
    <PackageVersion Include="AutoMapper.Collection" Version="13.0.0" />
    <!-- Mapster (MIT, AutoMapper 14+ 商业化后的替代选择) -->
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="1.0.1" />
    <!-- Logging -->
    <PackageVersion Include="log4net" Version="3.3.1" />
    <!-- HTTP & Serialization -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Refit" Version="8.0.0" />
    <PackageVersion Include="Refit.Newtonsoft.Json" Version="8.0.0" />
    <PackageVersion Include="RestSharp" Version="112.1.0" />
    <!-- Security -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- Cloud -->
    <PackageVersion Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
    <!-- Utilities -->
    <PackageVersion Include="Castle.Core" Version="5.2.1" />
    <PackageVersion Include="Dynamitey" Version="2.0.10.189" />
    <PackageVersion Include="ImpromptuInterface" Version="7.0.1" />
    <PackageVersion Include="Polly" Version="8.6.5" />
    <PackageVersion Include="Polly.Extensions" Version="8.6.5" />
    <PackageVersion Include="Snowflake.Core" Version="2.0.0" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.6.6" />
    <!-- SourceLink -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <!-- Stage 5 additions -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.9" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- 安全基线：集中钉住旧版上游包带入的易受攻击传递依赖 -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="SharpCompress" Version="0.50.7" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
