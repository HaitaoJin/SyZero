{
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/example1/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ],
      "UseServiceDiscovery": true,
      "DownstreamPathTemplate": "/api/example1/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "SyZero.Example1",
      "LoadBalancerOptions": {
        "Type": "LeastConnection"
      },
      "SwaggerKey": "SyZero.Example1"
    },
    {
      "UpstreamPathTemplate": "/api/example2/{everything}",
      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Put",
        "Delete",
        "Patch"
      ],
      "UseServiceDiscovery": true,
      "DownstreamPathTemplate": "/api/example2/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "SyZero.Example2",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "SwaggerKey": "SyZero.Example2"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "SyZero.Example1",
      "Config": [
        {
          "Name": "SyZero.Example1 API",
          "Version": "v1",
          "Service": {
            "Name": "SyZero.Example1",
            "Path": "/swagger/v1/swagger.json"
          }
        }
      ]
    },
    {
      "Key": "SyZero.Example2",
      "Config": [
        {
          "Name": "SyZero.Example2 API",
          "Version": "v1",
          "Service": {
            "Name": "SyZero.Example2",
            "Path": "/swagger/v1/swagger.json"
          }
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://127.0.0.1:5000",
    "ServiceDiscoveryProvider": {
      "Type": "SyZeroDiscovery"
    }
  }
}
