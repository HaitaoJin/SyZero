{
  "SyZero": {
    "Name": "SyZero.Gateway", //服务名称
    "Port": "5000", //端口号
    "Ip": "", //内网Ip
    "WanIp": "", //广域网Ip
    "Protocol": "HTTP", //协议 HTTP/HTTPS/GRPC 
    "InspectInterval": 5, //健康检查间隔 秒
    "CorsOrigins": "http://localhost:4200,http://localhost:8080,http://localhost:8081,http://localhost:3000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "GlobalConfiguration": {
    "BaseUrl": "http://127.0.0.1:5000", //网关对外地址
    "ServiceDiscoveryProvider": {
      "Type": "SyZeroDiscovery" //使用 SyZero 统一服务发现（本地联调默认走 LocalServiceManagement）
    }
  },
  "OpenTelemetry": {
    "OtlpUrl": "http://192.168.2.5:5317"
  },
  "Gateway": {
    "Admin": {
      "Username": "admin",
      "Password": "admin" //生产环境必须设置强密码；为空时 /admin 与 /admin-api 返回 503
    }
  },
  "LocalServiceManagement": {
    "EnableHealthCheck": true,
    "HealthCheckIntervalSeconds": 10,
    "Services": [
      {
        "ServiceName": "SyZero.Example1",
        "ServiceAddress": "localhost",
        "ServicePort": 5002,
        "ServiceProtocol": "HTTP",
        "HealthCheckUrl": "http://localhost:5002/health"
      },
      {
        "ServiceName": "SyZero.Example2",
        "ServiceAddress": "localhost",
        "ServicePort": 5003,
        "ServiceProtocol": "HTTP",
        "HealthCheckUrl": "http://localhost:5003/health"
      }
    ]
  }
}
