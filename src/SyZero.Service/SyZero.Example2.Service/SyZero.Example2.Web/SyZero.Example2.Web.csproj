<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>SyZero.Example2.Web.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\**" />
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.AspNetCore\SyZero.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.DynamicWebApi\SyZero.DynamicWebApi.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.Feign\SyZero.Feign.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.Logging.Log4Net\SyZero.Logging.Log4Net.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.Observability.OpenTelemetry\SyZero.Observability.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.Swagger\SyZero.Swagger.csproj" />
    <!-- v1.5.0 集成示例：默认开启 Diagnostics + AI Echo；Kafka / DistributedTransaction 在 Program.cs 以注释提供 -->
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.Diagnostics\SyZero.Diagnostics.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.AI\SyZero.AI.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.EventBus.Kafka\SyZero.EventBus.Kafka.csproj" />
    <ProjectReference Include="..\..\..\SyZero.Module\SyZero.DistributedTransaction\SyZero.DistributedTransaction.csproj" />
    <ProjectReference Include="..\SyZero.Example2.Application\SyZero.Example2.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Dockerfile">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="SyZero.Example2.Web.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

