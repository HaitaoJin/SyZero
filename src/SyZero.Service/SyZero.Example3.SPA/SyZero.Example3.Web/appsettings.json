{
  "SyZero": {
    "Name": "SyZero.Example3", //服务名称
    "Port": "5004", //端口号
    "Ip": "", //内网Ip
    "WanIp": "", //广域网Ip
    "Protocol": "HTTP", //协议 HTTP/HTTPS/GRPC
    "InspectInterval": 5, //健康检查间隔 秒
    "CorsOrigins": "http://localhost:5174,http://localhost:3000",
    "DynamicConfig": "" //动态配置(从consul/nacos中获取) 默认服务名
  },
  "ConnectionString": {
    "Master": "Data Source=app.db", //主库
    "Slave": [
      {
        "ConnectionString": "Data Source=app.db",
        "HitRate": 1
      }
    ],
    "Type": "Sqlite" //MySql|SqlServer|Sqlite|Oracle|PostgreSQL|Dm|Kdbndp
  },
  "App": {
    "ServerRootAddress": "http://SyZero.Example3.com",
    "ClientRootAddress": "http://SyZero.Example3.com",
    "CorsOrigins": "http://localhost:5174,http://localhost:3000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "JWT": {
    "SecurityKey": "123456789123456789",
    "expires": "7",
    "issuer": "SyZero.Example3.com",
    "audience": "SyZero.Example3.com"
  },
  "AllowedHosts": "*"
}
