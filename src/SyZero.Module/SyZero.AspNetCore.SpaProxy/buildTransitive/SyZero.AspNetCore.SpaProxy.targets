<Project>
  <PropertyGroup>
    <_SyZeroFrontendBuildAfterTargets>Build</_SyZeroFrontendBuildAfterTargets>
    <_SyZeroFrontendBuildAfterTargets Condition="'$(GenerateSwaggerJsonOnBuild)' == 'true'">SyZeroGenerateSwaggerJson</_SyZeroFrontendBuildAfterTargets>
  </PropertyGroup>

  <!-- WriteLinesToFile 会在 Linux 上把 ITaskItem 中的反斜杠规范化为斜杠，需直接写入 JSON。 -->
  <UsingTask TaskName="SyZeroWriteSpaProxyConfigurationTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputPath ParameterType="System.String" Required="true" />
      <ServerUrl ParameterType="System.String" Required="true" />
      <RedirectUrl ParameterType="System.String" Required="true" />
      <LaunchCommand ParameterType="System.String" Required="true" />
      <WorkingDirectory ParameterType="System.String" Required="true" />
      <MaxTimeoutInSeconds ParameterType="System.Int32" Required="true" />
      <KeepRunning ParameterType="System.Boolean" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, string> escapeJson = value =>
        {
            var escaped = new StringBuilder(value.Length + 16);
            foreach (var character in value)
            {
                switch (character)
                {
                    case '"': escaped.Append("\\\""); break;
                    case '\\': escaped.Append("\\\\"); break;
                    case '\b': escaped.Append("\\b"); break;
                    case '\f': escaped.Append("\\f"); break;
                    case '\n': escaped.Append("\\n"); break;
                    case '\r': escaped.Append("\\r"); break;
                    case '\t': escaped.Append("\\t"); break;
                    default:
                        if (character < 0x20)
                        {
                            escaped.Append("\\u").Append(((int)character).ToString("x4"));
                        }
                        else
                        {
                            escaped.Append(character);
                        }
                        break;
                }
            }

            return escaped.ToString();
        };

        var json = new StringBuilder()
            .AppendLine("{")
            .AppendLine("  \"SpaProxyServer\": {")
            .Append("    \"ServerUrl\": \"").Append(escapeJson(ServerUrl)).AppendLine("\",")
            .Append("    \"RedirectUrl\": \"").Append(escapeJson(RedirectUrl)).AppendLine("\",")
            .Append("    \"LaunchCommand\": \"").Append(escapeJson(LaunchCommand)).AppendLine("\",")
            .Append("    \"WorkingDirectory\": \"").Append(escapeJson(WorkingDirectory)).AppendLine("\",")
            .Append("    \"MaxTimeoutInSeconds\": ").Append(MaxTimeoutInSeconds).AppendLine(",")
            .Append("    \"KeepRunning\": ").AppendLine(KeepRunning ? "true" : "false")
            .AppendLine("  }")
            .AppendLine("}")
            .ToString();
        var outputDirectory = Path.GetDirectoryName(OutputPath);
        if (!string.IsNullOrEmpty(outputDirectory))
        {
            Directory.CreateDirectory(outputDirectory);
        }

        if (!File.Exists(OutputPath) ||
            !string.Equals(File.ReadAllText(OutputPath), json, StringComparison.Ordinal))
        {
            File.WriteAllText(OutputPath, json, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SyZeroWriteSpaConfigurationToDisk" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SpaProxyServerUrl)' != '' and '$(SpaProxyLaunchCommand)' != ''">
    <PropertyGroup>
      <_SpaProxyServerLaunchConfig>$(IntermediateOutputPath)spa.proxy.json</_SpaProxyServerLaunchConfig>
      <_SpaRootFullPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(SpaRoot)'))))</_SpaRootFullPath>
    </PropertyGroup>
    <SyZeroWriteSpaProxyConfigurationTask
        OutputPath="$(_SpaProxyServerLaunchConfig)"
        ServerUrl="$(SpaProxyServerUrl)"
        RedirectUrl="$(SpaProxyRedirectUrl)"
        LaunchCommand="$(SpaProxyLaunchCommand)"
        WorkingDirectory="$(_SpaRootFullPath)"
        MaxTimeoutInSeconds="$(SpaProxyTimeoutInSeconds)"
        KeepRunning="$(SpaProxyKeepRunning)" />
    <ItemGroup>
      <ContentWithTargetPath Include="$(_SpaProxyServerLaunchConfig)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" TargetPath="spa.proxy.json" />
      <FileWrites Include="$(_SpaProxyServerLaunchConfig)" />
    </ItemGroup>
  </Target>

  <Target Name="SyZeroBuildFrontend" AfterTargets="$(_SyZeroFrontendBuildAfterTargets)"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildFrontendOnBuild)' == 'true' and Exists('$(FrontendProjectPath)')">
    <Message Importance="High" Condition="'$(SwaggerOutputFile)' != ''" Text="Building frontend with Swagger input: $(SwaggerOutputFile)" />
    <Message Importance="High" Condition="'$(SwaggerOutputFile)' == ''" Text="Building frontend with Swagger input: $(TargetDir)swagger.json" />
    <Exec Condition="'$(SwaggerOutputFile)' != ''"
          Command="dotnet build &quot;$(FrontendProjectPath)&quot; -c $(Configuration)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="SWAGGER_INPUT_FILE=$(SwaggerOutputFile);CONFIGURATION=$(Configuration)" />
    <Exec Condition="'$(SwaggerOutputFile)' == ''"
          Command="dotnet build &quot;$(FrontendProjectPath)&quot; -c $(Configuration)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="SWAGGER_INPUT_FILE=$(TargetDir)swagger.json;CONFIGURATION=$(Configuration)" />
  </Target>

  <Target Name="SyZeroConfigureSpaProxyRunEnvironment" BeforeTargets="ComputeRunArguments"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SpaProxyServerUrl)' != '' and '$(SpaProxyLaunchCommand)' != '' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(_IsExecutable)' == 'true'">
    <PropertyGroup>
      <_SyZeroSpaProxyOriginalRunCommand>$(RunCommand)</_SyZeroSpaProxyOriginalRunCommand>
      <_SyZeroSpaProxyOriginalRunArguments>$(RunArguments)</_SyZeroSpaProxyOriginalRunArguments>
      <_SyZeroSpaProxyHostingStartupAssembly>SyZero.AspNetCore.SpaProxy</_SyZeroSpaProxyHostingStartupAssembly>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <RunCommand>cmd.exe</RunCommand>
      <RunArguments>/c &quot;set &quot;ASPNETCORE_HOSTINGSTARTUPASSEMBLIES=$(_SyZeroSpaProxyHostingStartupAssembly);%ASPNETCORE_HOSTINGSTARTUPASSEMBLIES%&quot; &amp;&amp; &quot;$(_SyZeroSpaProxyOriginalRunCommand)&quot; $(_SyZeroSpaProxyOriginalRunArguments)&quot;</RunArguments>
    </PropertyGroup>

    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
      <RunCommand>/bin/sh</RunCommand>
      <RunArguments>-c &quot;ASPNETCORE_HOSTINGSTARTUPASSEMBLIES=\&quot;$(_SyZeroSpaProxyHostingStartupAssembly)${ASPNETCORE_HOSTINGSTARTUPASSEMBLIES:+;${ASPNETCORE_HOSTINGSTARTUPASSEMBLIES}}\&quot; exec \&quot;$(_SyZeroSpaProxyOriginalRunCommand)\&quot; $(_SyZeroSpaProxyOriginalRunArguments)&quot;</RunArguments>
    </PropertyGroup>
  </Target>

  <Target Name="SyZeroCopyFrontendToPublish" AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildFrontendOnBuild)' == 'true' and Exists('$(FrontendDistDir)')">
    <ItemGroup>
      <_SyZeroFrontendDistFiles Include="$(FrontendDistDir)**/*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <Copy SourceFiles="@(_SyZeroFrontendDistFiles)"
          DestinationFiles="@(_SyZeroFrontendDistFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
