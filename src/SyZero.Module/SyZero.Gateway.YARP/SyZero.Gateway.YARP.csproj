<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>SyZero 网关模块的 YARP（Yet Another Reverse Proxy）实现，提供 IGateway / IGatewayConfigurationStore / IGatewayConfigurationApplier 的 YARP 后端，与 SyZero.Gateway.Ocelot 同级互斥。原名 SyZero.YARP，自 v1.6.0 起改名为 SyZero.Gateway.YARP。</Description>
    <PackageTags>SyZero;Gateway;YARP;ReverseProxy</PackageTags>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SyZero.Core\SyZero.Core.csproj" />
    <ProjectReference Include="..\SyZero.Gateway.Abstractions\SyZero.Gateway.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

</Project>
