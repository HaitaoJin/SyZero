@page "/admin/backups"
@model SyZero.Gateway.Admin.Pages.Admin.BackupsModel
@{
    ViewData["Title"] = "备份";
    ViewData["Subtitle"] = "下载 / 还原 / 删除 configuration.backup.*.json";
}

<div class="flex justify-between items-center mb-4">
    <button class="btn btn-sm" onclick="loadBackups()">刷新</button>
</div>

<div class="alert alert-info mb-4">
    <span>每次写入网关配置时会自动创建一份备份。文件型存储默认保留最近 10 份，可通过 <code>Gateway:Admin:Backup:MaxCount</code> 修改。</span>
</div>

<div class="card bg-base-100 shadow">
    <div class="card-body p-0">
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr><th>Id</th><th>创建时间</th><th>大小</th><th class="w-60">操作</th></tr>
                </thead>
                <tbody id="backups-tbody"><tr><td colspan="4" class="text-center opacity-50">加载中…</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fmtSize(n) {
            if (n < 1024) return n + ' B';
            if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
            return (n / 1024 / 1024).toFixed(2) + ' MB';
        }
        async function loadBackups() {
            try {
                const items = await adminFetch('/admin-api/backups');
                const tbody = document.getElementById('backups-tbody');
                if (!items || items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center opacity-50">（无备份；当前 IGatewayConfigurationStore 实现可能不支持备份枚举）</td></tr>';
                    return;
                }
                tbody.innerHTML = items.map(b => `
                    <tr>
                        <td><code>${b.id}</code></td>
                        <td>${new Date(b.createdAt).toLocaleString()}</td>
                        <td>${fmtSize(b.sizeBytes || 0)}</td>
                        <td class="whitespace-nowrap">
                            <a class="btn btn-xs" target="_blank" href="/admin-api/backups/${encodeURIComponent(b.id)}/download">下载</a>
                            <button class="btn btn-xs btn-warning" onclick="restoreBackup('${b.id}')">还原</button>
                            <button class="btn btn-xs btn-error" onclick="deleteBackup('${b.id}')">删除</button>
                        </td>
                    </tr>`).join('');
            } catch (e) { adminToast(e.message, 'error'); }
        }
        async function restoreBackup(id) {
            if (!confirm('确认用备份 ' + id + ' 覆盖当前配置？该操作前会自动备份当前配置。')) return;
            try { await adminFetch('/admin-api/backups/' + encodeURIComponent(id) + '/restore', { method: 'POST', body: '{}' }); adminToast('还原成功', 'success'); await loadBackups(); }
            catch (e) { adminToast(e.message, 'error'); }
        }
        async function deleteBackup(id) {
            if (!confirm('确认删除备份 ' + id + '？')) return;
            try { await adminFetch('/admin-api/backups/' + encodeURIComponent(id), { method: 'DELETE' }); adminToast('已删除', 'success'); await loadBackups(); }
            catch (e) { adminToast(e.message, 'error'); }
        }
        loadBackups();
    </script>
}
