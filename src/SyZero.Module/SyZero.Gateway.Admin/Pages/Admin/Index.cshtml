@page "/admin"
@model SyZero.Gateway.Admin.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "概览";
    ViewData["Subtitle"] = "健康状态、统计、Provider 与运行时分歧";
}

<div id="diverged-banner" class="alert alert-warning shadow mb-4 hidden">
    <span>
        ⚠ 磁盘配置与运行时配置不一致<span id="diff-summary" class="ml-2"></span>，建议<a href="/admin/diff" class="link link-primary ml-1">查看 Diff</a>或点击「从磁盘重载」。
    </span>
</div>

<div class="flex justify-between items-center mb-3">
    <div class="text-sm opacity-60" id="last-refresh">最后刷新：—</div>
    <div class="flex gap-2 items-center">
        <label class="text-sm opacity-60">自动刷新</label>
        <select id="poll-interval" class="select select-bordered select-xs">
            <option value="0">关闭</option>
            <option value="5">5 秒</option>
            <option value="15" selected>15 秒</option>
            <option value="30">30 秒</option>
            <option value="60">60 秒</option>
        </select>
        <button class="btn btn-xs" onclick="refreshAll()">⟳ 立即刷新</button>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <div class="text-sm opacity-60">路由总数</div>
            <div class="text-3xl font-bold" id="stat-routes">-</div>
        </div>
    </div>
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <div class="text-sm opacity-60">Swagger 端点</div>
            <div class="text-3xl font-bold" id="stat-swagger">-</div>
        </div>
    </div>
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <div class="text-sm opacity-60">网关版本</div>
            <div class="text-3xl font-bold" id="stat-version">-</div>
        </div>
    </div>
    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <div class="text-sm opacity-60">Provider</div>
            <div class="text-3xl font-bold" id="stat-provider">-</div>
        </div>
    </div>
</div>

<div class="card bg-base-100 shadow mt-4">
    <div class="card-body">
        <h2 class="card-title">系统信息</h2>
        <table class="table">
            <tbody>
                <tr><td class="opacity-60 w-1/3">配置文件路径</td><td><code id="info-path">-</code></td></tr>
                <tr><td class="opacity-60">最近备份时间</td><td id="info-backup">-</td></tr>
                <tr><td class="opacity-60">磁盘配置 SHA256</td><td><code id="info-stored-hash">-</code></td></tr>
                <tr><td class="opacity-60">运行时配置 SHA256</td><td><code id="info-runtime-hash">-</code></td></tr>
                <tr><td class="opacity-60">审计日志</td><td id="info-audit">-</td></tr>
            </tbody>
        </table>
        <div class="card-actions justify-end">
            <button class="btn btn-primary btn-sm" onclick="reloadConfig()">从磁盘重载</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pollTimer = null;
        let refreshInFlight = null;
        let refreshQueued = false;
        let lastDiffKey = null;

        async function loadHealth(silent) {
            try {
                const data = await adminFetch('/admin-api/health', { timeoutMs: 8000 });
                document.getElementById('stat-routes').textContent = data.routeCount;
                document.getElementById('stat-swagger').textContent = data.swaggerEndPointCount;
                document.getElementById('stat-version').textContent = data.version || '-';
                document.getElementById('info-path').textContent = data.configPath;
                document.getElementById('info-backup').textContent = data.lastBackupTime || '（无）';
                document.getElementById('info-audit').textContent = data.auditEnabled ? '已启用' : '已禁用';
                return data;
            } catch (e) {
                if (!silent) adminToast(e.message, 'error');
                return null;
            }
        }
        async function loadRuntime(silent) {
            try {
                const data = await adminFetch('/admin-api/runtime', { timeoutMs: 12000 });
                document.getElementById('stat-provider').textContent = data.providerName || '（无）';
                document.getElementById('info-stored-hash').textContent = (data.storedHash || '-').substring(0, 16) + '…';
                document.getElementById('info-runtime-hash').textContent = data.runtimeHash ? data.runtimeHash.substring(0, 16) + '…' : '（无）';
                const banner = document.getElementById('diverged-banner');
                const diffKey = data.diverged ? `${data.storedHash || ''}|${data.runtimeHash || ''}` : null;
                if (data.diverged) {
                    banner.classList.remove('hidden');
                    if (diffKey && diffKey !== lastDiffKey) {
                        await loadDiffSummary(true);
                        lastDiffKey = diffKey;
                    }
                } else {
                    banner.classList.add('hidden');
                    document.getElementById('diff-summary').textContent = '';
                    lastDiffKey = null;
                }
                return data;
            } catch (e) {
                if (!silent) adminToast(e.message, 'error');
                return null;
            }
        }
        async function loadDiffSummary(silent) {
            try {
                const d = await adminFetch('/admin-api/runtime/diff', { timeoutMs: 15000 });
                const stored = (d.stored || '').split('\n');
                const runtime = (d.runtime || '').split('\n');
                // 简单的 LCS 计数：使用 Set 行模式（不严格，但足以粗略反映出入）
                const setStored = new Map();
                for (const ln of stored) setStored.set(ln, (setStored.get(ln) || 0) + 1);
                let removed = 0; // 仅在 stored 中存在
                let added = 0;   // 仅在 runtime 中存在
                const setRuntime = new Map();
                for (const ln of runtime) setRuntime.set(ln, (setRuntime.get(ln) || 0) + 1);
                for (const [ln, c] of setStored) {
                    const c2 = setRuntime.get(ln) || 0;
                    if (c > c2) removed += (c - c2);
                }
                for (const [ln, c] of setRuntime) {
                    const c2 = setStored.get(ln) || 0;
                    if (c > c2) added += (c - c2);
                }
                if (added || removed) {
                    document.getElementById('diff-summary').innerHTML =
                        `<span class="badge badge-success badge-sm ml-2">+${added}</span>` +
                        `<span class="badge badge-error badge-sm ml-1">-${removed}</span>`;
                } else {
                    document.getElementById('diff-summary').textContent = '';
                }
            } catch (e) {
                if (!silent) adminToast(e.message, 'error');
            }
        }
        async function reloadConfig() {
            try { await adminFetch('/admin-api/reload', { method: 'POST' }); adminToast('已重新从磁盘加载', 'success'); await refreshAll(); }
            catch (e) { adminToast(e.message, 'error'); }
        }
        async function refreshAll(options) {
            options = options || {};
            if (document.hidden) return refreshInFlight || Promise.resolve();
            if (refreshInFlight) {
                refreshQueued = true;
                return refreshInFlight;
            }
            const silent = !!options.silent;
            refreshInFlight = (async function () {
                await Promise.all([loadHealth(silent), loadRuntime(silent)]);
                const now = new Date();
                document.getElementById('last-refresh').textContent = '最后刷新：' + now.toLocaleTimeString();
            })();
            try {
                await refreshInFlight;
            } finally {
                refreshInFlight = null;
                if (refreshQueued && !document.hidden) {
                    refreshQueued = false;
                    setTimeout(function () { refreshAll({ silent: true }); }, 0);
                }
            }
        }
        function applyPoll() {
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
            const sec = Number(document.getElementById('poll-interval').value);
            if (sec > 0) {
                pollTimer = setInterval(function () {
                    if (!document.hidden) refreshAll({ silent: true });
                }, sec * 1000);
            }
            try { localStorage.setItem('gw-overview-poll', String(sec)); } catch { }
        }
        function handleVisibilityChange() {
            if (!document.hidden) {
                refreshAll({ silent: true });
            }
        }
        // 初始化：从 localStorage 还原选择
        try {
            const saved = localStorage.getItem('gw-overview-poll');
            if (saved !== null) document.getElementById('poll-interval').value = saved;
        } catch { }
        document.getElementById('poll-interval').addEventListener('change', applyPoll);
        document.addEventListener('visibilitychange', handleVisibilityChange);
        if (window.registerAdminCleanup) {
            window.registerAdminCleanup(function () {
                if (pollTimer) clearInterval(pollTimer);
                document.removeEventListener('visibilitychange', handleVisibilityChange);
            });
        }
        refreshAll({ silent: false }).finally(applyPoll);
    </script>
}

