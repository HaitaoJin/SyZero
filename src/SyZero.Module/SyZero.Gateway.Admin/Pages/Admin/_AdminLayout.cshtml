@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    bool IsActive(string prefix, bool exact = false) =>
        exact
            ? currentPath.Equals(prefix, System.StringComparison.OrdinalIgnoreCase)
              || currentPath.Equals(prefix + "/", System.StringComparison.OrdinalIgnoreCase)
            : currentPath.StartsWith(prefix, System.StringComparison.OrdinalIgnoreCase);
    string ActiveCls(string prefix, bool exact = false) => IsActive(prefix, exact) ? "active gw-menu-active" : string.Empty;

    var user = Context.User?.Identity?.Name;
    var role = Context.User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Admin";
    var isAdmin = string.Equals(role, "Admin", System.StringComparison.OrdinalIgnoreCase);
    var isBuiltIn = string.Equals(
        Context.User?.FindFirst("gw:builtin")?.Value,
        "true", System.StringComparison.OrdinalIgnoreCase);
    var gatewayAdminVersion = typeof(SyZero.Gateway.Admin.Controllers.AdminController)
        .Assembly.GetName().Version?.ToString(3) ?? "-";
    ViewData["IsAdmin"] = isAdmin;
    ViewData["Role"] = role;
    ViewData["IsBuiltIn"] = isBuiltIn;
    if (string.IsNullOrEmpty(user) && Context.Request.Cookies.TryGetValue("syz_admin_auth", out var cookie))
    {
        try
        {
            var raw = System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(cookie));
            var idx = raw.IndexOf(':');
            if (idx > 0) { user = raw.Substring(0, idx); }
        }
        catch { /* ignore */ }
    }

    // 计算面包屑标题。
    string PageTitle()
    {
        if (IsActive("/admin", exact: true)) return "概览";
        if (IsActive("/admin/routes")) return "路由管理";
        if (IsActive("/admin/route-overview")) return "路由概览";
        if (IsActive("/admin/swagger-endpoints")) return "Swagger 端点";
        if (IsActive("/admin/service-interfaces")) return "服务接口";
        if (IsActive("/admin/backups")) return "备份";
        if (IsActive("/admin/raw-editor")) return "原生 JSON";
        if (IsActive("/admin/diff")) return "运行时 Diff";
        if (IsActive("/admin/audit")) return "审计日志";
        if (IsActive("/admin/rate-limiting")) return "限流管理";
        if (IsActive("/admin/load-balancing")) return "负载均衡";
        if (IsActive("/admin/users")) return "用户管理";
        if (IsActive("/admin/tester")) return "路由测试器";
        return ViewData["Title"]?.ToString() ?? "网关管理";
    }

    string PageIconSvg()
    {
        if (IsActive("/admin", exact: true))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 12l9-9 9 9M5 10v10h4v-6h6v6h4V10\"/></svg>";
        if (IsActive("/admin/routes"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 6h16M4 12h16M4 18h10\"/></svg>";
        if (IsActive("/admin/route-overview"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18\"/></svg>";
        if (IsActive("/admin/swagger-endpoints"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 5h14v4H5zM5 11h14v8H5z\"/></svg>";
        if (IsActive("/admin/service-interfaces"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 7h10M7 12h10M7 17h6\"/><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/></svg>";
        if (IsActive("/admin/rate-limiting"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 3\"/></svg>";
        if (IsActive("/admin/load-balancing"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"6\" cy=\"6\" r=\"2\"/><circle cx=\"18\" cy=\"6\" r=\"2\"/><circle cx=\"12\" cy=\"18\" r=\"2\"/><path d=\"M8 7.5l2.5 7M16 7.5l-2.5 7\"/></svg>";
        if (IsActive("/admin/backups"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><ellipse cx=\"12\" cy=\"6\" rx=\"7\" ry=\"3\"/><path d=\"M5 6v8c0 1.7 3.1 3 7 3s7-1.3 7-3V6\"/></svg>";
        if (IsActive("/admin/raw-editor"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M8 8l-4 4 4 4M16 8l4 4-4 4\"/></svg>";
        if (IsActive("/admin/diff"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3v18M7 8l-4 4 4 4M17 8l4 4-4 4\"/></svg>";
        if (IsActive("/admin/audit"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11\"/></svg>";
        if (IsActive("/admin/users"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M16 11a4 4 0 10-8 0 4 4 0 008 0zM3 21a7 7 0 0114 0M17 11a3 3 0 100-6M21 21a5 5 0 00-7-4.6\"/></svg>";
        if (IsActive("/admin/tester"))
            return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12l5 5L20 7\"/></svg>";
        return "<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 12h4l3-9 4 18 3-9h4\"/></svg>";
    }
}
<!DOCTYPE html>
<html lang="zh-cn" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@PageTitle() - SyZero 网关管理</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // 主题在 head 中尽早应用，避免闪烁。
        (function () {
            try {
                var t = localStorage.getItem('gw-admin-theme') || 'light';
                document.documentElement.setAttribute('data-theme', t);
                var darks = ['dark', 'dracula', 'business', 'night', 'synthwave', 'black', 'halloween', 'forest', 'luxury', 'coffee', 'sunset'];
                if (darks.indexOf(t) >= 0) document.documentElement.classList.add('gw-dark');
                if (localStorage.getItem('gw-side-collapsed') === '1') document.documentElement.classList.add('gw-side-collapsed');
            } catch {}
        })();
    </script>
    <style>
        body { font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif; }
        .gw-brand-grad { background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); }
        .gw-text-grad { background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .gw-card-anim { animation: gwFadeIn .35s ease-out both; }
        @@keyframes gwFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
        .gw-side-icon { width: 1.15rem; height: 1.15rem; flex-shrink: 0; }
        .gw-side-menu li > a { transition: background-color .15s ease, color .15s ease; position: relative; }
        /* 侧栏选中状态：渐变左条 + 渐变背景 + 主色字（最高优先级，覆盖 daisyUI 默认 active/:where 规则）
           注意：daisyUI 4.10+ 主题变量为 oklch（不是 hsl），必须用 oklch() 包裹才能解析 */
        .gw-side-menu li > a.gw-menu-active,
        .gw-side-menu li > a.gw-menu-active:hover,
        .gw-side-menu li > a.gw-menu-active:focus,
        .gw-side-menu li > a.gw-menu-active:active,
        .gw-side-menu li > a.gw-menu-active.active,
        ul.gw-side-menu li > a.active.gw-menu-active {
            background-color: oklch(var(--p) / 0.16) !important;
            background-image: linear-gradient(135deg, oklch(var(--p) / 0.24) 0%, oklch(var(--s) / 0.18) 100%) !important;
            color: oklch(var(--p)) !important;
            font-weight: 600;
            box-shadow: inset 0 0 0 1px oklch(var(--p) / 0.32);
        }
        .gw-side-menu li > a.gw-menu-active::before {
            content: '';
            position: absolute;
            left: 0; top: 8px; bottom: 8px;
            width: 3px; border-radius: 2px;
            background: linear-gradient(180deg, oklch(var(--p)) 0%, oklch(var(--s)) 100%);
        }
        .gw-side-menu li > a.gw-menu-active .gw-side-icon { color: oklch(var(--p)); }
        /* 折叠态下选中项也保持背景 */
        html.gw-side-collapsed .gw-side-menu li > a.gw-menu-active {
            background-image: linear-gradient(135deg, oklch(var(--p) / 0.30) 0%, oklch(var(--s) / 0.22) 100%) !important;
        }
        /* 通用加载骨架 */
        .gw-skeleton { background: linear-gradient(90deg, hsl(var(--b3) / .35) 0%, hsl(var(--b3) / .55) 50%, hsl(var(--b3) / .35) 100%); background-size: 200% 100%; animation: gwSkel 1.4s ease-in-out infinite; border-radius: 0.4rem; }
        @@keyframes gwSkel { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
        /* 空态 */
        .gw-empty { padding: 2.5rem 1rem; text-align: center; color: hsl(var(--bc) / .55); }
        .gw-empty svg { margin: 0 auto 0.75rem; opacity: 0.5; }
        /* 统一卡片视觉：让所有 .card / .stats / table 容器更柔和 */
        main .card, main .stats, main .rounded-box.bg-base-100, main .bg-base-100.shadow,
        main .bg-base-100.shadow-sm, main > .bg-base-100, main .alert {
            border-radius: 0.85rem;
        }
        main .card.bg-base-100, main .stats.bg-base-100 {
            box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 4px 14px rgba(15,23,42,.06);
            border: 1px solid hsl(var(--b3) / .35);
        }
        main table.table thead th { font-weight: 600; letter-spacing: .02em; }
        .btn { border-radius: 0.6rem; }
        /* 顶部加载进度条 */
        #gw-progress { position: fixed; top: 0; left: 0; height: 2px; width: 0%; background: linear-gradient(90deg, hsl(var(--p)) 0%, hsl(var(--s)) 100%); box-shadow: 0 0 8px hsl(var(--p) / 0.5); z-index: 100; transition: width .25s ease, opacity .3s ease; opacity: 0; pointer-events: none; }
        #gw-progress.active { opacity: 1; }
        /* 返回顶部按钮 */
        #gw-back-top { position: fixed; right: 1.25rem; bottom: 1.25rem; opacity: 0; transform: translateY(8px); transition: opacity .25s ease, transform .25s ease; pointer-events: none; z-index: 40; }
        #gw-back-top.show { opacity: 1; transform: none; pointer-events: auto; }
        /* Toast 增强：hover 暂停淖出 */
        .gw-toast-item { animation: gwToastIn .22s ease-out both; max-width: 360px; }
        @@keyframes gwToastIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: none; } }
        /* dark/light 快捷切换图标联动 */
        .gw-theme-sun, .gw-theme-moon { display: none; }
        html.gw-dark .gw-theme-sun { display: inline-block; }
        html:not(.gw-dark) .gw-theme-moon { display: inline-block; }
        /* 侧边栏折叠（仅桌面 lg+ 生效）*/
        .gw-side-collapse-ico-in { display: none; }
        @@media (min-width: 1024px) {
            html.gw-side-collapsed .gw-side-panel { width: 4.25rem !important; padding-left: .35rem !important; padding-right: .35rem !important; }
            html.gw-side-collapsed .gw-side-label,
            html.gw-side-collapsed .gw-side-brand-text { display: none !important; }
            html.gw-side-collapsed .gw-side-brand { justify-content: center; padding-left: .25rem; padding-right: .25rem; gap: 0; }
            html.gw-side-collapsed .gw-side-menu li > a { justify-content: center; padding-left: .5rem; padding-right: .5rem; }
            html.gw-side-collapsed .menu-title { display: none !important; }
            html.gw-side-collapsed .gw-side-foot { justify-content: center; }
            html.gw-side-collapsed .gw-side-collapse-ico-out { display: none; }
            html.gw-side-collapsed .gw-side-collapse-ico-in { display: inline-block; }
        }
    </style>
</head>
<body class="min-h-screen bg-base-200">
    <div id="gw-progress"></div>
    <button id="gw-back-top" class="btn btn-circle btn-primary shadow-lg" title="返回顶部" aria-label="返回顶部">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 15l7-7 7 7"/></svg>
    </button>
    <div class="drawer lg:drawer-open">
        <input id="gw-drawer" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col min-h-screen">
            <div class="navbar bg-base-100/80 backdrop-blur shadow-sm sticky top-0 z-30 border-b border-base-300">
                <div class="flex-none lg:hidden">
                    <label for="gw-drawer" class="btn btn-ghost btn-square btn-sm" aria-label="打开菜单">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </label>
                </div>
                <div class="flex-none hidden lg:flex">
                    <button id="gw-side-collapse" class="btn btn-ghost btn-square btn-sm" title="折叠侧边栏" aria-label="折叠侧边栏">
                        <svg class="w-5 h-5 gw-side-collapse-ico-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
                        <svg class="w-5 h-5 gw-side-collapse-ico-in" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                    </button>
                </div>
                <div class="flex-1 gap-3 min-w-0">
                    <span class="lg:hidden inline-flex items-center gap-2 px-2">
                        <span class="w-9 h-9 rounded-xl gw-brand-grad text-white inline-flex items-center justify-center text-sm font-bold shadow">SZ</span>
                        <span class="text-base font-semibold gw-text-grad hidden sm:inline">SyZero 网关</span>
                    </span>
                    <div class="text-sm breadcrumbs hidden md:flex text-base-content/70 min-w-0">
                        <ul>
                            <li><a href="/admin">首页</a></li>
                            <li class="truncate">@PageTitle()</li>
                        </ul>
                    </div>
                </div>
                <div class="flex-none gap-2">
                    <span id="admin-sse-status" class="badge badge-warning badge-sm hidden sm:inline-flex" title="实时事件总线（SSE）连接状态">○ 重连中</span>
                    <button id="gw-theme-toggle" class="btn btn-ghost btn-sm btn-square" title="快捷切换 dark / light" aria-label="快捷切换主题">
                        <svg class="gw-theme-sun w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                        <svg class="gw-theme-moon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/></svg>
                    </button>
                    <div class="dropdown dropdown-end">
                        <label tabindex="0" class="btn btn-ghost btn-sm gap-1" title="切换主题">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                            <span class="hidden sm:inline">主题</span>
                        </label>
                        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box shadow-lg w-44 p-2 z-50 max-h-80 overflow-y-auto">
                            @foreach (var t in new[] { "light", "dark", "corporate", "business", "emerald", "cupcake", "synthwave", "dracula", "winter", "night" })
                            {
                                <li><a data-theme-set="@t">@t</a></li>
                            }
                        </ul>
                    </div>
                    @if (!string.IsNullOrEmpty(user))
                    {
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-ghost btn-sm gap-2">
                                <div class="avatar placeholder">
                                    <div class="bg-primary text-primary-content rounded-full w-7">
                                        <span class="text-xs">@user.Substring(0, 1).ToUpper()</span>
                                    </div>
                                </div>
                                <span class="hidden sm:inline">@user</span>
                            </label>
                            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box shadow-lg w-44 p-2 z-50">
                                <li class="menu-title">
                                    <span class="flex items-center gap-1">@user
                                        @if (isAdmin)
                                        {
                                            <span class="badge badge-primary badge-xs">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-ghost badge-xs">Reader</span>
                                        }
                                        @if (isBuiltIn)
                                        {
                                            <span class="badge badge-outline badge-xs ml-1" title="appsettings 内置">内置</span>
                                        }
                                    </span>
                                </li>
                                <li><a href="/admin/users">用户管理</a></li>
                                <li><a href="/admin/logout">退出登录</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </div>

            <main class="flex-1 container mx-auto p-4 gw-card-anim w-full">
                @{
                    var pageTitle = PageTitle();
                    var subtitle = ViewData["Subtitle"] as string;
                }
                <div class="mb-4 flex items-center gap-3">
                    <span class="w-10 h-10 rounded-xl gw-brand-grad text-white inline-flex items-center justify-center shadow-sm">
                        @Html.Raw(PageIconSvg())
                    </span>
                    <div class="min-w-0">
                        <h1 class="text-2xl font-semibold leading-tight gw-text-grad truncate">@pageTitle</h1>
                        @if (!string.IsNullOrEmpty(subtitle))
                        {
                            <p class="text-sm text-base-content/60 mt-0.5">@subtitle</p>
                        }
                    </div>
                </div>
                @RenderBody()
            </main>

            <footer class="footer footer-center p-4 text-base-content/60 text-xs border-t border-base-300/50">
                <aside>
                    <span>SyZero · Gateway Admin <span class="badge badge-ghost badge-sm ml-1">v@(gatewayAdminVersion)</span></span>
                    <span class="opacity-50">·</span>
                    <a class="link link-hover" href="https://github.com/SyZeroToInfinity/SyZero" target="_blank" rel="noopener">GitHub</a>
                </aside>
            </footer>
        </div>

        <aside class="drawer-side z-40">
            <label for="gw-drawer" aria-label="关闭菜单" class="drawer-overlay"></label>
            <div class="bg-base-100 min-h-full p-3 shadow-xl border-r border-base-300 flex flex-col gw-side-panel" style="width:16rem; transition: width .2s ease;">
                <a href="/admin" class="flex items-center gap-2 px-2 py-3 mb-2 border-b border-base-300/60 hover:bg-base-200/60 rounded-lg transition gw-side-brand" title="返回首页 / SyZero 网关管理台">
                    <span class="w-10 h-10 rounded-xl gw-brand-grad text-white inline-flex items-center justify-center text-sm font-bold shadow flex-shrink-0">SZ</span>
                    <span class="flex flex-col leading-tight gw-side-brand-text">
                        <span class="text-base font-semibold gw-text-grad">网关管理台</span>
                        <span class="text-[11px] text-base-content/60">SyZero</span>
                    </span>
                    <label for="gw-drawer" class="btn btn-ghost btn-sm btn-square ml-auto lg:hidden" aria-label="关闭菜单">✕</label>
                </a>
                <ul class="menu rounded-box gw-side-menu" data-auto-close="true">
                    <li>
                        <a href="/admin" class="@ActiveCls("/admin", exact: true)" title="概览">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9M5 10v10h4v-6h6v6h4V10"/></svg>
                            <span class="gw-side-label">概览</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/routes" class="@ActiveCls("/admin/routes")" title="路由管理">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                            <span class="gw-side-label">路由管理</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/route-overview" class="@ActiveCls("/admin/route-overview")" title="路由概览">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"/></svg>
                            <span class="gw-side-label">路由概览</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/swagger-endpoints" class="@ActiveCls("/admin/swagger-endpoints")" title="Swagger 端点">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v4H4zM4 10h16v4H4zM4 16h16v4H4z"/></svg>
                            <span class="gw-side-label">Swagger 端点</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/service-interfaces" class="@ActiveCls("/admin/service-interfaces")" title="服务接口">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10M7 12h10M7 17h6"/><rect x="3" y="4" width="18" height="16" rx="2"/></svg>
                            <span class="gw-side-label">服务接口</span>
                        </a>
                    </li>
                    <li class="menu-title gw-side-label"><span>高级</span></li>
                    <li>
                        <a href="/admin/rate-limiting" class="@ActiveCls("/admin/rate-limiting")" title="限流管理">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a9 9 0 100 18 9 9 0 000-18z"/><path d="M12 7v5l3 2"/></svg>
                            <span class="gw-side-label">限流管理</span>
                        </a>
