                        <a href="/admin/diff" class="@ActiveCls("/admin/diff")" title="运行时 Diff">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M7 8l-4 4 4 4M17 8l4 4-4 4"/></svg>
                            <span class="gw-side-label">运行时 Diff</span>
                        </a>
