                </ul>
                <div class="mt-auto pt-3 flex items-center justify-center gw-side-foot">
                    <span class="text-[11px] text-base-content/40 gw-side-label">SyZero v@(gatewayAdminVersion)</span>
                </div>
            </div>
        </aside>
    </div>

    <div id="toast-host" class="toast toast-end z-50"></div>
    <script>
        // ===== 页面级清理钩子 =====
        (function () {
            const cleanupFns = [];
            let cleaned = false;
            window.registerAdminCleanup = function (fn) {
                if (typeof fn === 'function') cleanupFns.push(fn);
            };
            window.runAdminCleanup = function () {
                if (cleaned) return;
                cleaned = true;
                while (cleanupFns.length) {
                    const fn = cleanupFns.pop();
                    try { fn && fn(); } catch {}
                }
            };
            window.addEventListener('pagehide', window.runAdminCleanup, { once: true });
            window.addEventListener('beforeunload', window.runAdminCleanup, { once: true });
        })();

        // ===== 主题切换 =====
        var gwDarkThemes = ['dark', 'dracula', 'business', 'night', 'synthwave', 'black', 'halloween', 'forest', 'luxury', 'coffee', 'sunset'];
        function gwApplyTheme(t) {
            document.documentElement.setAttribute('data-theme', t);
            try { localStorage.setItem('gw-admin-theme', t); } catch {}
            if (gwDarkThemes.indexOf(t) >= 0) document.documentElement.classList.add('gw-dark');
            else document.documentElement.classList.remove('gw-dark');
        }
        document.querySelectorAll('[data-theme-set]').forEach(el => {
            el.addEventListener('click', () => {
                gwApplyTheme(el.getAttribute('data-theme-set'));
            });
        });
        (function () {
            var btn = document.getElementById('gw-theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var cur = document.documentElement.getAttribute('data-theme') || 'light';
                var isDark = gwDarkThemes.indexOf(cur) >= 0;
                gwApplyTheme(isDark ? 'light' : 'dark');
            });
        })();

        // ===== Toast =====
        window.adminToast = function (msg, type) {
            const host = document.getElementById('toast-host');
            const div = document.createElement('div');
            type = type || 'info';
            const icons = {
                info: '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
                success: '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
                warning: '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/></svg>',
                error: '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>'
            };
            div.className = 'gw-toast-item alert alert-' + type + ' shadow-lg flex items-start gap-2';
            div.innerHTML = (icons[type] || icons.info) + '<span class="flex-1 text-sm">' + msg + '</span>'
                + '<button class="btn btn-ghost btn-xs btn-circle" aria-label="关闭">✕</button>';
            host.appendChild(div);
            let paused = false;
            let elapsed = 0;
            const lifeMs = type === 'error' ? 6000 : 3000;
            const timer = setInterval(function () {
                if (paused) return;
                elapsed += 100;
                if (elapsed >= lifeMs) { clearInterval(timer); fadeOut(); }
            }, 100);
            function fadeOut() {
                div.style.transition = 'opacity .3s, transform .3s';
                div.style.opacity = '0';
                div.style.transform = 'translateX(20px)';
                setTimeout(function () { div.remove(); }, 320);
            }
            div.addEventListener('mouseenter', function () { paused = true; });
            div.addEventListener('mouseleave', function () { paused = false; });
            div.querySelector('button').addEventListener('click', function () { clearInterval(timer); fadeOut(); });
        };

        // ===== 顶部进度条 =====
        (function () {
            var bar = document.getElementById('gw-progress');
            var pending = 0; var width = 0; var timer = null;
            window.adminProgress = {
                start: function () {
                    pending++;
                    if (pending === 1) {
                        width = 10; bar.style.width = '10%'; bar.classList.add('active');
                        clearInterval(timer);
                        timer = setInterval(function () {
                            if (width < 85) { width += (90 - width) * 0.08; bar.style.width = width + '%'; }
                        }, 200);
                    }
                },
                done: function () {
                    pending = Math.max(0, pending - 1);
                    if (pending === 0) {
                        clearInterval(timer); timer = null;
                        width = 100; bar.style.width = '100%';
                        setTimeout(function () { bar.classList.remove('active'); bar.style.width = '0%'; width = 0; }, 350);
                    }
                }
            };
        })();

        // ===== 返回顶部 =====
        (function () {
            var btn = document.getElementById('gw-back-top');
            window.addEventListener('scroll', function () {
                if (window.scrollY > 240) btn.classList.add('show'); else btn.classList.remove('show');
            }, { passive: true });
            btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
        })();

        // ===== 移动端：点击侧栏菜单后自动关闭抽屉 =====
        (function () {
            var drawerInput = document.getElementById('gw-drawer');
            if (!drawerInput) return;
            document.querySelectorAll('.gw-side-menu a[href]').forEach(function (a) {
                a.addEventListener('click', function () {
                    if (window.matchMedia('(max-width: 1023.98px)').matches) {
                        drawerInput.checked = false;
                    }
                });
            });
        })();

        // ===== 桌面侧边栏折叠 =====
        (function () {
            var btn = document.getElementById('gw-side-collapse');
            if (!btn) return;
            function syncTitle() {
                var collapsed = document.documentElement.classList.contains('gw-side-collapsed');
                btn.title = collapsed ? '展开侧边栏' : '折叠侧边栏';
                btn.setAttribute('aria-label', btn.title);
            }
            syncTitle();
            btn.addEventListener('click', function () {
                document.documentElement.classList.toggle('gw-side-collapsed');
                try { localStorage.setItem('gw-side-collapsed', document.documentElement.classList.contains('gw-side-collapsed') ? '1' : '0'); } catch {}
                syncTitle();
            });
        })();

        // ===== Fetch 包装：401 自动跳登录页 + 顶部进度条 =====
        window.__adminFetchControllers = window.__adminFetchControllers || new Set();
        if (window.registerAdminCleanup) {
            window.registerAdminCleanup(function () {
                window.__adminFetchControllers.forEach(function (controller) {
                    try { controller.abort(); } catch {}
                });
                window.__adminFetchControllers.clear();
            });
        }
        window.adminFetch = async function (url, options) {
            options = options || {};
            const method = String(options.method || 'GET').toUpperCase();
            const headers = Object.assign({}, options.headers || {});
            if (!headers['Content-Type'] && !headers['content-type'] && method !== 'GET' && method !== 'HEAD') {
                headers['Content-Type'] = 'application/json';
            }
            options.headers = headers;
            options.credentials = options.credentials || 'same-origin';
            const timeoutMs = typeof options.timeoutMs === 'number'
                ? options.timeoutMs
                : (method === 'GET' || method === 'HEAD' ? 10000 : 20000);
            const externalSignal = options.signal;
            const controller = new AbortController();
            let timedOut = false;
            let timeoutId = null;
            let externalAbortHandler = null;
            if (externalSignal) {
                if (externalSignal.aborted) controller.abort();
                else {
                    externalAbortHandler = function () { controller.abort(); };
                    externalSignal.addEventListener('abort', externalAbortHandler, { once: true });
                }
            }
            options.signal = controller.signal;
            delete options.timeoutMs;
            window.__adminFetchControllers.add(controller);
            if (timeoutMs > 0) {
                timeoutId = setTimeout(function () {
                    timedOut = true;
                    try { controller.abort(); } catch {}
                }, timeoutMs);
            }
            if (window.adminProgress) window.adminProgress.start();
            try {
                const resp = await fetch(url, options);
                if (resp.status === 401) {
                    const ret = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.replace('/admin/login?returnUrl=' + ret);
                    throw new Error('未登录或会话已过期');
                }
                if (resp.status === 204 || resp.status === 201) return null;
                const text = await resp.text();
                const data = text ? JSON.parse(text) : null;
                if (!resp.ok) {
                    const msg = (data && (data.title || data.detail)) || ('请求失败 ' + resp.status);
                    throw new Error(msg);
                }
                return data;
            } catch (e) {
                if (controller.signal.aborted) {
                    throw new Error(timedOut ? '请求超时，请稍后重试' : '请求已取消');
                }
                throw e;
            } finally {
                if (timeoutId) clearTimeout(timeoutId);
                if (externalSignal && externalAbortHandler) {
                    try { externalSignal.removeEventListener('abort', externalAbortHandler); } catch {}
                }
                window.__adminFetchControllers.delete(controller);
                if (window.adminProgress) window.adminProgress.done();
            }
        };

        // ===== 加载骨架 / 空态 =====
        window.adminSkeletonRows = function (rowCount, colCount) {
            rowCount = rowCount || 4; colCount = colCount || 4;
            let html = '';
            for (let r = 0; r < rowCount; r++) {
                html += '<tr>';
                for (let c = 0; c < colCount; c++) {
                    html += '<td><div class="gw-skeleton h-4" style="width:' + (50 + Math.floor(Math.random() * 40)) + '%"></div></td>';
                }
                html += '</tr>';
            }
            return html;
        };
        window.adminEmpty = function (msg, hint) {
            return '<div class="gw-empty">'
                + '<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg>'
                + '<div class="text-sm">' + (msg || '暂无数据') + '</div>'
                + (hint ? '<div class="text-xs opacity-60 mt-1">' + hint + '</div>' : '')
                + '</div>';
        };

        // ---------- SSE 实时事件总线 ----------
        // 单页订阅 /admin-api/events，将事件分发到 window.addEventListener('admin:event', ...)
        // 同时根据事件类型弹出 toast 提示。页面可监听特定 type 触发自动刷新。
        (function () {
            if (window.__adminSse) return;
            let es = null;
            let backoff = 1000;
            let badgeEl = null;
            let reconnectTimer = null;
            function setStatus(state) {
                if (!badgeEl) return;
                badgeEl.classList.remove('badge-success', 'badge-warning', 'badge-error');
                if (state === 'live') { badgeEl.classList.add('badge-success'); badgeEl.textContent = '● 实时'; }
                else if (state === 'reconnect') { badgeEl.classList.add('badge-warning'); badgeEl.textContent = '○ 重连中'; }
                else { badgeEl.classList.add('badge-error'); badgeEl.textContent = '× 离线'; }
            }
            function attachBadge() {
                badgeEl = document.getElementById('admin-sse-status');
                if (badgeEl) setStatus(es && es.readyState === 1 ? 'live' : 'reconnect');
            }
            function clearReconnect() {
                if (reconnectTimer) {
                    clearTimeout(reconnectTimer);
                    reconnectTimer = null;
                }
            }
            function closeStream() {
                clearReconnect();
                if (es) {
                    try { es.close(); } catch { }
                    es = null;
                }
            }
            function connect() {
                if (document.hidden || es) return;
                try {
                    es = new EventSource('/admin-api/events', { withCredentials: true });
                    es.onopen = function () { backoff = 1000; setStatus('live'); };
                    es.onerror = function () {
                        closeStream();
                        setStatus('reconnect');
                        if (document.hidden) return;
                        // 自动重连：指数退避到 30s 上限
                        reconnectTimer = setTimeout(connect, backoff);
                        backoff = Math.min(backoff * 2, 30000);
                    };
                    es.onmessage = function (e) { dispatch({ type: 'message', data: e.data }); };
                    // 监听所有已知事件名（统一通过 event:<type>）
                    var knownEvents = [
                        'config.reload', 'config.replace',
                        'route.create', 'route.update', 'route.delete', 'route.move',
                        'route.clone', 'route.bulk-toggle', 'route.bulk-tags', 'route.reorder', 'route.import',
                        'swagger.create', 'swagger.update', 'swagger.delete',
                        'backup.restore', 'backup.delete'
                    ];
                    knownEvents.forEach(function (t) {
                        es.addEventListener(t, function (ev) {
                            var payload; try { payload = JSON.parse(ev.data); } catch { payload = { type: t }; }
                            payload.type = payload.type || t;
                            dispatch(payload);
                        });
                    });
                } catch (err) {
                    setStatus('offline');
                }
            }
            function dispatch(evt) {
                window.dispatchEvent(new CustomEvent('admin:event', { detail: evt }));
                if (evt && evt.type && evt.type !== 'message') {
                    var who = evt.user ? '@@' + evt.user : '';
                    var toast = window.adminToast;
                    if (toast && !document.hidden) toast(evt.summary || evt.type, 'info');
                    // 控制台辅助
                    try { console.debug('[admin-sse]', evt.type, who, evt); } catch { }
                }
            }
            function handleVisibilityChange() {
                if (document.hidden) {
                    closeStream();
                    setStatus('reconnect');
                    return;
                }
                connect();
            }
            window.__adminSse = { connect: connect, attachBadge: attachBadge };
            document.addEventListener('visibilitychange', handleVisibilityChange);
            if (window.registerAdminCleanup) {
                window.registerAdminCleanup(function () {
                    document.removeEventListener('visibilitychange', handleVisibilityChange);
                    closeStream();
                });
            }
            // 页面加载完成后启动
            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                attachBadge(); connect();
            } else {
                document.addEventListener('DOMContentLoaded', function () { attachBadge(); connect(); });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
