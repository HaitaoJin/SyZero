                        <a href="/admin/audit" class="@ActiveCls("/admin/audit")" title="审计日志">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                            <span class="gw-side-label">审计日志</span>
