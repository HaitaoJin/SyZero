                        <a href="/admin/tester" class="@ActiveCls("/admin/tester")" title="路由测试器">
                            <svg class="gw-side-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5L20 7"/></svg>
