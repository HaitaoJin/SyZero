@page "/admin/users"
@model SyZero.Gateway.Admin.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "用户管理";
    ViewData["Subtitle"] = "管理 appsettings 内置账号与 users.json 文件账号";
    bool isAdmin = ViewData["IsAdmin"] is bool b && b;
}

<div class="alert alert-info mb-4">
    <span>
        本面板从 1.2.3 起支持多账号 + 角色（<b>Admin</b> / <b>Reader</b>）。
        <b>appsettings</b> 中 <code>Gateway:Admin:Users[]</code> 为内置账号（只读），
        <b>users.json</b> 中的账号支持运行时增删改。
    </span>
</div>

<div class="flex flex-wrap items-center gap-2 mb-4">
    <button class="btn btn-sm" onclick="loadUsers()">刷新</button>
    <button class="btn btn-sm btn-primary" onclick="openCreate()" disabled="@(!isAdmin)" title="@(isAdmin ? "新增 users.json 用户" : "需要 Admin 权限")">新增用户</button>
    <button class="btn btn-sm btn-ghost ml-auto" onclick="openMyPwd()">修改我的密码</button>
</div>

@if (!isAdmin)
{
    <div class="alert alert-warning mb-4">
        <span>当前账号为 <b>Reader</b>，可查看用户列表和修改自己的密码，但不能新增、编辑、删除其他账号</span>
    </div>
}

<div class="card bg-base-100 shadow">
    <div class="card-body p-0">
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>用户名</th>
                        <th>角色</th>
                        <th>来源</th>
                        <th class="w-60">操作</th>
                    </tr>
                </thead>
                <tbody id="users-tbody"><tr><td colspan="4" class="text-center opacity-50">加载中…</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<!-- 创建对话框 -->
<dialog id="dlg-create" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">新增用户</h3>
        <div class="form-control mb-2">
            <label class="label"><span class="label-text">用户名</span></label>
            <input id="cu-name" class="input input-bordered" />
        </div>
        <div class="form-control mb-2">
            <label class="label"><span class="label-text">密码</span></label>
            <input id="cu-pwd" type="password" class="input input-bordered" />
        </div>
        <div class="form-control mb-4">
            <label class="label"><span class="label-text">角色</span></label>
            <select id="cu-role" class="select select-bordered">
                <option value="Admin">Admin（可写）</option>
                <option value="Reader">Reader（只读）</option>
            </select>
        </div>
        <div class="modal-action">
            <button class="btn" onclick="document.getElementById('dlg-create').close()">取消</button>
            <button class="btn btn-primary" onclick="submitCreate()">创建</button>
        </div>
    </div>
</dialog>

<!-- 编辑对话框 -->
<dialog id="dlg-edit" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">编辑用户 <span id="eu-name-disp" class="font-mono"></span></h3>
        <input id="eu-name" type="hidden" />
        <div class="form-control mb-2">
            <label class="label"><span class="label-text">新密码（留空表示不修改）</span></label>
            <input id="eu-pwd" type="password" class="input input-bordered" />
        </div>
        <div class="form-control mb-4">
            <label class="label"><span class="label-text">角色</span></label>
            <select id="eu-role" class="select select-bordered">
                <option value="Admin">Admin</option>
                <option value="Reader">Reader</option>
            </select>
        </div>
        <div class="modal-action">
            <button class="btn" onclick="document.getElementById('dlg-edit').close()">取消</button>
            <button class="btn btn-primary" onclick="submitEdit()">保存</button>
        </div>
    </div>
</dialog>

<!-- 改我的密码 -->
<dialog id="dlg-mypwd" class="modal">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">修改我的密码</h3>
        <div class="form-control mb-2">
            <label class="label"><span class="label-text">原密码</span></label>
            <input id="mp-old" type="password" class="input input-bordered" />
        </div>
        <div class="form-control mb-4">
            <label class="label"><span class="label-text">新密码</span></label>
            <input id="mp-new" type="password" class="input input-bordered" />
        </div>
        <div class="modal-action">
            <button class="btn" onclick="document.getElementById('dlg-mypwd').close()">取消</button>
            <button class="btn btn-primary" onclick="submitMyPwd()">提交</button>
        </div>
    </div>
</dialog>

@section Scripts {
    <script>
        const isAdmin = @(isAdmin ? "true" : "false");

        async function loadUsers() {
            const tbody = document.getElementById('users-tbody');
            try {
                const list = await adminFetch('/admin-api/users');
                if (!list || list.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center opacity-50">（无用户）</td></tr>';
                    return;
                }
                tbody.innerHTML = list.map(u => `
                    <tr>
                        <td><code>${u.name}</code></td>
                        <td>${u.role === 'Admin'
                            ? '<span class="badge badge-primary">Admin</span>'
                            : '<span class="badge badge-ghost">Reader</span>'}</td>
                        <td>${u.isBuiltIn
                            ? '<span class="badge badge-outline">appsettings</span>'
                            : '<span class="badge badge-outline badge-success">users.json</span>'}</td>
                        <td class="whitespace-nowrap">
                            ${(isAdmin && !u.isBuiltIn)
                                ? `<button class="btn btn-xs" onclick="openEdit('${u.name.replace(/'/g, "\\'")}','${u.role}')">编辑</button>
                                   <button class="btn btn-xs btn-error" onclick="delUser('${u.name.replace(/'/g, "\\'")}')">删除</button>`
                                : '<span class="opacity-50 text-xs">' + (u.isBuiltIn ? '内置（请编辑 appsettings）' : '需 Admin 权限') + '</span>'}
                        </td>
                    </tr>
                `).join('');
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="4" class="text-error">加载失败：${e.message || e}</td></tr>`;
            }
        }

        function openCreate() {
            if (!isAdmin) { adminToast('需要 Admin 权限才能新增用户', 'warning'); return; }
            document.getElementById('cu-name').value = '';
            document.getElementById('cu-pwd').value = '';
            document.getElementById('cu-role').value = 'Admin';
            document.getElementById('dlg-create').showModal();
        }

        async function submitCreate() {
            const body = {
                name: document.getElementById('cu-name').value.trim(),
                password: document.getElementById('cu-pwd').value,
                role: document.getElementById('cu-role').value,
            };
            if (!body.name || !body.password) { adminToast('请填写用户名和密码', 'error'); return; }
            try {
                await adminFetch('/admin-api/users', { method: 'POST', body: JSON.stringify(body) });
                document.getElementById('dlg-create').close();
                adminToast('已创建', 'success');
                loadUsers();
            } catch (e) { adminToast(e.message || '创建失败', 'error'); }
        }

        function openEdit(name, role) {
            document.getElementById('eu-name').value = name;
            document.getElementById('eu-name-disp').textContent = name;
            document.getElementById('eu-pwd').value = '';
            document.getElementById('eu-role').value = role;
            document.getElementById('dlg-edit').showModal();
        }

        async function submitEdit() {
            const name = document.getElementById('eu-name').value;
            const pwd = document.getElementById('eu-pwd').value;
            const role = document.getElementById('eu-role').value;
            const body = { role };
            if (pwd) body.password = pwd;
            try {
                await adminFetch('/admin-api/users/' + encodeURIComponent(name), { method: 'PUT', body: JSON.stringify(body) });
                document.getElementById('dlg-edit').close();
                adminToast('已保存', 'success');
                loadUsers();
            } catch (e) { adminToast(e.message || '保存失败', 'error'); }
        }

        async function delUser(name) {
            if (!confirm(`确认删除用户 "${name}" ?`)) return;
            try {
                await adminFetch('/admin-api/users/' + encodeURIComponent(name), { method: 'DELETE' });
                adminToast('已删除', 'success');
                loadUsers();
            } catch (e) { adminToast(e.message || '删除失败', 'error'); }
        }

        function openMyPwd() {
            document.getElementById('mp-old').value = '';
            document.getElementById('mp-new').value = '';
            document.getElementById('dlg-mypwd').showModal();
        }

        async function submitMyPwd() {
            const oldPassword = document.getElementById('mp-old').value;
            const newPassword = document.getElementById('mp-new').value;
            if (!oldPassword || !newPassword) { adminToast('原密码与新密码不能为空', 'error'); return; }
            try {
                await adminFetch('/admin-api/me/password', {
                    method: 'POST',
                    body: JSON.stringify({ oldPassword, newPassword })
                });
                document.getElementById('dlg-mypwd').close();
                adminToast('已修改密码', 'success');
            } catch (e) { adminToast(e.message || '修改失败', 'error'); }
        }

        loadUsers();
    </script>
}

